# Copy this file to .env and adjust before running docker compose.
#
#   cd server && cp .env.example .env && docker compose up -d
#
# Anything marked "MUST replace" needs a fresh value before production.

ENV=development
LOG_LEVEL=info

# ---- Postgres -------------------------------------------------------------
# Username is hard-coded to `mdm` in docker-compose; only the password is
# configurable here.
POSTGRES_PASSWORD=mdm

# ---- JWT signing ----------------------------------------------------------
# MUST replace in production. Use at least 32 random bytes:
#   openssl rand -base64 48
# Every service that issues/verifies JWTs reads this from the env.
JWT_SECRET=replace-me-with-a-real-32-byte-random-key

# ---- MQTT broker (Mosquitto) ---------------------------------------------
# Agent uses these credentials to subscribe to its per-device command topic.
MQTT_USER=mdm
MQTT_PASS=mdmpass

# ---- MinIO / object storage ----------------------------------------------
# Used for APK uploads, device photo captures, log bundles. MUST replace in
# production — minioadmin/minioadmin is a known-public credential pair.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Fallback public host the presigner uses when the inbound HTTP request has no
# X-Forwarded-Host (rare; mostly direct curl). The admin nginx normally
# overrides this per-request, so a remote browser sees URLs that resolve on
# its own network without any static reconfiguration. set-server-ip.sh keeps
# this aligned with the host IP.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ---- Public base URL ------------------------------------------------------
# Goes into QR enrollment payloads and the APK download link served back to
# new phones. Must be reachable from the device's network. The port here MUST
# match WEB_PORT below (the published console port). This is a dev LAN IP — if
# the host's DHCP lease changes, run ./set-server-ip.sh <ip> (updates this,
# TURN_URL, MINIO_PUBLIC_ENDPOINT + the DB) or devices get stranded.
PUBLIC_BASE_URL=https://mdm.example.com

# ---- Initial super-admin --------------------------------------------------
# The first login, seeded ONCE on a fresh database (empty ./infra/pgdata) by
# infra/migrations/010_seed_superadmin.sh — the password is bcrypt-hashed at
# seed time, never stored in plaintext or hardcoded in SQL. MUST replace the
# password before exposing the deployment. To change it on an already-running
# stack, see server/README.md ("Changing the super-admin login").
SUPERADMIN_EMAIL=admin@mdm.local
SUPERADMIN_PASSWORD=ChangeMe!123

# ---- Host port mappings ---------------------------------------------------
# WEB_PORT is THE port of the whole setup: the browser, the API (proxied), and
# the MQTT-over-WebSocket bridge all come through nginx on this one port. To run
# the console on, say, 9090: set WEB_PORT=9090 AND update PUBLIC_BASE_URL's port
# to 9090. WEB_PORT_HTTP is the extra plain-:80 binding so the agent's bare
# `http://<host>` URL (no port) keeps working — set it to the same value as
# WEB_PORT if you don't need the :80 convenience.
WEB_PORT=8080
WEB_PORT_HTTP=80
# Infrastructure host ports (change only if they collide with something else on
# the host; internal service-to-service wiring is unaffected).
POSTGRES_PORT=5432
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MQTT_TCP_PORT=1883
MQTT_WS_PORT=9001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9101
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
TRAEFIK_DASHBOARD_PORT=8081

# ---- WebRTC screen-mirror (TURN / coturn) ---------------------------------
# Shared secret + the TURN URL handed to clients. TURN_URL host must be the LAN
# IP devices+browsers reach (keep in sync with PUBLIC_BASE_URL; set-server-ip.sh
# updates it). MUST replace the secret in production.
TURN_SECRET=changeme-turn-secret
TURN_URL=turn:mdm.example.com:3478
