# Claude
.claude/
**/.claude/

# Android build output
android-agent/**/build/
android-agent/**/.gradle/
android-agent/.gradle/
android-agent/local.properties
android-agent/captures/
android-agent/.idea/
android-agent/*.iml
android-agent/**/*.iml
*.apk
*.aab
*.ap_
*.dex
*.class
*.keystore
*.jks
# Allow the debug signing keystore committed in the private repo as backup
!android-agent/.signing/debug.keystore

# NOTE: gradle/wrapper/gradle-wrapper.jar is intentionally committed — it must
# be in the repo for `./gradlew` to work on a fresh clone and in CI.

# Go build artifacts
server/**/bin/
server/**/*.exe
server/**/*.test
server/**/*.out

# Node / admin-web
server/admin-web/node_modules/
server/admin-web/dist/
server/admin-web/.vite/
server/admin-web/npm-debug.log*

# Docker / runtime data
server/data/
server/**/data/
**/postgres-data/
**/minio-data/
**/mosquitto-data/

# Env / secrets
.env
.env.*
# But always ship .env.example — it's a template, not a secret.
!.env.example
!**/.env.example
*.pem
*.key
*.crt

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# TypeScript incremental build metadata (tsc -b)
*.tsbuildinfo
.github/workflows/
server/infra/seaweedfs/s3.json
